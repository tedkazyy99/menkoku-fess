# Database PostgreSQL (Wajib)
# Sesuaikan user, password, host, port, dan nama database
DATABASE_URL="postgresql://menfess_user:yourpassword@localhost:5432/menfess"

# Cloudinary Storage (Wajib untuk hosting kartu gambar Instagram)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Instagram Handle Akun Bot
IG_HANDLE="@fesstembayo"

# Admin Dashboard Protection
ADMIN_PASSWORD=""

# Security Salt & Reverse Proxy Trust
SALT="menfess_secure_salt_change_me"
TRUST_PROXY="false"

# Server Port (Default: 3000)
PORT=3000

# Opsional: Instagram Meta Graph API (Fallback jika memposting direct tanpa python worker)
INSTAGRAM_ACCOUNT_ID=""
META_ACCESS_TOKEN=""
